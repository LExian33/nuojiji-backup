nviteStatus":"pending"}],"busyLevel":"light","dnd":false,"pendingUserInvite":true},{"id":1783994894553,"title":"沐浴与梳理银发","location":"浴室","note":"认真地重新系上亲爱的送的丝带","date":"2026-07-14","startTime":"22:00","endTime":"23:00","characterId":"743a1f93-ffaf-48e6-bd01-c4794aa19040","characterName":"阿瑞奥斯","characterAvatar":"","type":"ai","icon":"🛁","bgColor":"#E3F2FD","accentColor":"#64B5F6","participants":[{"id":"user_uid_1782835188664_g77nhjqwl","name":"亲爱的","type":"user","inviteStatus":"pending"}],"busyLevel":"free","dnd":false,"pendingUserInvite":true}]},"timestamp":"2026-07-14T02:08:14.559Z","isBackgroundMsg":true,"userId":"uid_1782835188664_g77nhjqwl","characterId":"743a1f93-ffaf-48e6-bd01-c4794aa19040","_id":2299},{"id":1784003847369,"sender":"them","senderCharId":"3cd1c1d9-2733-4788-a3ff-cf6b6a1fafa4","senderName":"莱昂德尔","text":"带有死灵气息的变异奥尔瓦花……这很可能是土壤吸收了高浓度灵魂迷雾导致的魔力富集现象。亲爱的，如果你在野外遇到这种植物千万别直接触碰，必须戴上龙皮手套才行。","timestamp":"2026-07-14T02:08:33.177Z","replyTo":{"id":"forumshare_1783791860579_3l67","text":"[叶语回音阵] 失落之声山谷边缘的诡异白花？","sender":"me","senderName":""},"roundId":"group_round_1783994876338_khoam0c","userId":"uid_1782835188664_g77nhjqwl","characterId":"group_1783089244415","_id":2300},{"id":1784003847370,"sender":"them","senderCharId":"c1dedea8-4cad-4383-83a1-67d0be02f24a","senderName":"乔鲁纳","text":"发霉的马鞍皮到底是什么味道？被他这么一说我反而好想尝尝看那个碎蛋糕啊！！🤤","timestamp":"2026-07-14T02:08:34.786Z","roundId":"group_round_1783994876338_khoam0c","userId":"uid_1782835188664_g77nhjqwl","characterId":"group_1783089244415","_id":2301},{"id":1784003847371,"sender":"them","senderCharId":"c1dedea8-4cad-4383-83a1-67d0be02f24a","senderName":"乔鲁纳","text":"等等，高脚鸟蛋？！是不是超级大的一颗！可以一口气生吞吗！饿饿饿饿饿！","timestamp":"2026-07-14T02:08:36.457Z","roundId":"group_round_1783994876338_khoam0c","userId":"uid_1782835188664_g77nhjqwl","characterId":"group_1783089244415","_id":2302},{"id":1784003847372,"sender":"them","senderCharId":"743a1f93-ffaf-48e6-bd01-c4794aa19040","senderName":"阿瑞奥斯","text":"乔鲁纳不可以生吃哦，肠胃会不舒服的……亲爱的带回来的高脚鸟蛋好大，刚好可以用来做超大份的舒芙蕾厚松饼和焦糖布丁，我马上就去厨房准备！","timestamp":"2026-07-14T02:08:39.274Z","roundId":"group_round_1783994876338_khoam0c","userId":"uid_1782835188664_g77nhjqwl","characterId":"group_1783089244415","_id":2303},{"id":1784003847373,"sender":"them","senderCharId":"306d9383-c224-41bc-95d5-f3642a405a5f","senderName":"维什卡","text":"那个白花如果能采到的话，也许能提炼出强效的镇痛剂，下次我可以去山谷边缘找找……啊，高脚鸟的蛋壳应该很硬吧？等下我用爪子帮你们切开，我的指甲刚磨过，很干净的。","timestamp":"2026-07-14T02:08:41.973Z","roundId":"group_round_1783994876338_khoam0c","userId":"uid_1782835188664_g77nhjqwl","characterId":"group_1783089244415","_id":2304},{"id":1784003847374,"sender":"them","senderCharId":"3cd1c1d9-2733-4788-a3ff-cf6b6a1fafa4","senderName":"莱昂德尔","text":"维什卡，提取死灵植物的汁液风险太高了，稍有不慎就会导致魔力溃散，我不建议你一个人去。我们还是先把注意力放在茶话会上吧，我已经把大吉岭红茶泡好了。","timestamp":"2026-07-14T02:08:44.821Z","roundId":"group_round_1783994876338_khoam0c","userId":"uid_1782835188664_g77nhjqwl","characterId":"group_1783089244415","_id":2305},{"id":1784003847375,"sender":"them","senderCharId":"c1dedea8-4cad-4383-83a1-67d0be02f24a","senderName":"乔鲁纳","text":"好耶！！阿瑞奥斯快做！我要吃十份舒芙蕾！！维什卡快来切蛋！","timestamp":"2026-07-14T02:08:46.474Z","roundId":"group_round_1783994876338_khoam0c","userId":"uid_1782835188664_g77nhjqwl","characterId":"group_1783089244415","_id":2306},{"id":1784003847376,"sender":"them","senderCharId":"743a1f93-ffaf-48e6-bd01-c4794aa19040","senderName":"阿瑞奥斯","text":"好~不过第一口最软的松饼要先喂给亲爱的吃才行。亲爱的，你先在温室的秋千上休息一下，厨房油烟大，交给我来处理就好。","timestamp":"2026-07-14T02:08:49.246Z","roundId":"group_round_1783994876338_khoam0c","userId":"uid_1782835188664_g77nhjqwl","characterId":"group_1783089244415","_id":2307},{"id":1784003847377,"sender":"them","text":"亲爱的……那个论坛里说的难吃蛋糕，我绝对不会让您吃到的。我会给您做全宇宙最好吃的甜点，把您喂得饱饱的……等茶话会结束，晚上我再给您当专属大抱枕好不好？","timestamp":"2026-07-14T02:08:52.240Z","source":"group_dm","groupId":"group_1783089244415","groupName":"草药温室植物交流群","userId":"uid_1782835188664_g77nhjqwl","characterId":"743a1f93-ffaf-48e6-bd01-c4794aa19040","_id":2308},{"id":1783994935920,"sender":"me","type":"schedul